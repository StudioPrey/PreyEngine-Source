<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>MyEngine.Editor</RootNamespace>
    <ApplicationIcon>EditorAssets\engine_logo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pinned to an exact version, not floating "3.8.*" — see MyEngine.Core.csproj for why 3.8.4.1
         specifically. Content.Builder.Task tracks the same version as the Framework package it builds
         content for; MonoGame always releases every package in a given version together. -->
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.4.1" />
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.4.1" />
    <PackageReference Include="ImGui.NET" Version="1.91.6.1" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bundled editor-only icons (camera gizmo, etc.) — not part of any game project, so these live
         next to the Editor's own code rather than in a user project's Assets/. -->
    <None Include="EditorAssets\**" Exclude="EditorAssets\Icons\svg\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MyEngine.Core\MyEngine.Core.csproj" />
    <ProjectReference Include="..\MyEngine.EditorFramework\MyEngine.EditorFramework.csproj" />
  </ItemGroup>

</Project>
