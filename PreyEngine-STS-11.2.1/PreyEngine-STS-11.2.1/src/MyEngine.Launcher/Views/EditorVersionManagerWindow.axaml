<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MyEngine.Launcher.ViewModels"
        x:Class="MyEngine.Launcher.Views.EditorVersionManagerWindow"
        x:DataType="vm:EditorVersionManagerViewModel"
        Title="Manage Editor Versions"
        Width="620" Height="520"
        MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}">

  <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="20">

    <TextBlock Grid.Row="0" Text="Installed Editor Versions" FontSize="18" FontWeight="Bold"
               Foreground="{StaticResource AppTextPrimaryBrush}" Margin="0,0,0,12" />

    <Border Grid.Row="1" Background="{StaticResource AppPanelBrush}" CornerRadius="10" Padding="8">
      <ListBox ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedRow}"
               Background="Transparent" BorderThickness="0">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Border Background="{StaticResource AppPanelAltBrush}" CornerRadius="8" Padding="12">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="2">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding Label}" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource AppTextPrimaryBrush}" />
                    <Border Background="{StaticResource AppAccentBrush}" CornerRadius="4" Padding="6,1"
                            IsVisible="{Binding IsDefault}">
                      <TextBlock Text="DEFAULT" FontSize="10" FontWeight="Bold" Foreground="White" />
                    </Border>
                  </StackPanel>
                  <TextBlock Text="{Binding FolderPath}" FontSize="11" Foreground="{StaticResource AppTextSecondaryBrush}"
                             TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="11" VerticalAlignment="Center"
                           Foreground="{StaticResource AppWarningBrush}" IsVisible="{Binding !IsValid}" />
              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
      <Button Content="Set as Default" Classes="subtle" Command="{Binding SetDefaultCommand}"
              IsEnabled="{Binding CanSetDefault}" />
      <Button Content="Remove" Classes="subtle" Command="{Binding RemoveCommand}"
              IsEnabled="{Binding CanRemove}" />
      <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource AppTextSecondaryBrush}"
                 VerticalAlignment="Center" Margin="8,0,0,0" />
    </StackPanel>

    <Border Grid.Row="3" Background="{StaticResource AppPanelBrush}" CornerRadius="10" Padding="16" Margin="0,16,0,0">
      <StackPanel Spacing="10">
        <TextBlock Text="ADD VERSION" Classes="sectionTitle" />
        <TextBlock Text="Pick the folder containing a built copy of the Editor (e.g. its bin\Debug\net8.0 output)."
                   FontSize="11" Foreground="{StaticResource AppTextSecondaryBrush}" TextWrapping="Wrap" />
        <TextBox Watermark="Version name (e.g. &quot;0.6.0&quot;)" Text="{Binding NewLabel}" />
        <Grid ColumnDefinitions="*,Auto">
          <TextBox Grid.Column="0" Watermark="Editor build folder" Text="{Binding NewFolderPath}" />
          <Button Grid.Column="1" Content="…" Classes="subtle" Margin="6,0,0,0" Click="OnBrowseNewVersionFolder" />
        </Grid>
        <Button Content="Add Version" Classes="accent" HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center" Command="{Binding AddCommand}" />
      </StackPanel>
    </Border>

  </Grid>

</Window>
