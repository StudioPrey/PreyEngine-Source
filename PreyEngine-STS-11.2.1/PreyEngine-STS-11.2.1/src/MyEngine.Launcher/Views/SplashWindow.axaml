<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MyEngine.Launcher.ViewModels"
        x:Class="MyEngine.Launcher.Views.SplashWindow"
        x:DataType="vm:SplashWindowViewModel"
        Title="PreyEngine"
        Width="420" Height="260"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        SystemDecorations="None"
        Background="{StaticResource AppBackgroundBrush}">

  <Border BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="14">
      <Image Source="/Assets/logo.png" Width="64" Height="64" HorizontalAlignment="Center" />
      <TextBlock Text="PreyEngine"
                 FontSize="26" FontWeight="Bold"
                 Foreground="{StaticResource AppTextPrimaryBrush}"
                 HorizontalAlignment="Center" />
      <TextBlock Text="{Binding StatusText}"
                 FontSize="13"
                 Foreground="{StaticResource AppTextSecondaryBrush}"
                 HorizontalAlignment="Center" />
      <ProgressBar IsIndeterminate="True" Width="220" Height="3" Margin="0,10,0,0" />
    </StackPanel>
  </Border>

</Window>
