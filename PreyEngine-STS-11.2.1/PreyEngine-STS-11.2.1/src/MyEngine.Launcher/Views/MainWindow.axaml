<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MyEngine.Launcher.ViewModels"
        x:Class="MyEngine.Launcher.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="PreyEngine Launcher"
        Width="1040" Height="680"
        MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}"
        Icon="/Assets/logo.png">

  <Grid RowDefinitions="Auto,*,Auto" Margin="24">

    <!-- Header -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,20">
      <Image Grid.Column="0" Source="/Assets/logo.png" Width="40" Height="40" VerticalAlignment="Center" />
      <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
        <TextBlock Text="PreyEngine" FontSize="22" FontWeight="Bold" Foreground="{StaticResource AppTextPrimaryBrush}" />
        <TextBlock Text="2D Game Engine — Project Launcher" FontSize="12" Foreground="{StaticResource AppTextSecondaryBrush}" />
      </StackPanel>
      <Button Grid.Column="2" Content="Manage Versions" Classes="subtle"
              Command="{Binding ManageVersionsCommand}" VerticalAlignment="Center" />
    </Grid>

    <!-- Body -->
    <Grid Grid.Row="1" ColumnDefinitions="2*,16,320">

      <!-- Left: recent projects -->
      <Grid Grid.Column="0" RowDefinitions="Auto,*">
        <TextBlock Grid.Row="0" Text="RECENT PROJECTS" Classes="sectionTitle" Margin="4,0,0,10" />

        <Border Grid.Row="1" Background="{StaticResource AppPanelBrush}" CornerRadius="10" Padding="10">
          <Grid>
            <ScrollViewer>
              <ItemsControl ItemsSource="{Binding Projects}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="{StaticResource AppPanelAltBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,8">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                     Foreground="{StaticResource AppTextPrimaryBrush}" />
                          <TextBlock Text="{Binding Path}" FontSize="11" Foreground="{StaticResource AppTextSecondaryBrush}"
                                     TextTrimming="CharacterEllipsis" />
                          <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="{Binding LastOpenedDisplay}" FontSize="11"
                                       Foreground="{StaticResource AppTextSecondaryBrush}" />
                            <TextBlock Text="Folder not found" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource AppWarningBrush}" IsVisible="{Binding IsMissing}" />
                          </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                          <ComboBox ItemsSource="{Binding AvailableVersions}" SelectedItem="{Binding SelectedVersion}" MinWidth="130">
                            <ComboBox.ItemTemplate>
                              <DataTemplate>
                                <TextBlock Text="{Binding Label}" />
                              </DataTemplate>
                            </ComboBox.ItemTemplate>
                          </ComboBox>
                          <Button Content="Open" Classes="accent" Command="{Binding OpenCommand}" />
                          <Button Content="✕" Classes="subtle" Command="{Binding RemoveCommand}" ToolTip.Tip="Remove from list" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>

            <TextBlock Text="No projects yet — create one on the right."
                       Foreground="{StaticResource AppTextSecondaryBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsVisible="{Binding HasNoProjects}" />
          </Grid>
        </Border>
      </Grid>

      <!-- Right: create / open / version summary -->
      <StackPanel Grid.Column="2" Spacing="16">

        <Border Background="{StaticResource AppPanelBrush}" CornerRadius="10" Padding="16">
          <StackPanel Spacing="10">
            <TextBlock Text="NEW PROJECT" Classes="sectionTitle" />
            <TextBox Watermark="Project name" Text="{Binding NewProjectName}" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBox Grid.Column="0" Watermark="Location" Text="{Binding NewProjectLocation}" />
              <Button Grid.Column="1" Content="…" Classes="subtle" Margin="6,0,0,0" Click="OnBrowseNewProjectLocation" />
            </Grid>
            <Button Content="Create Project" Classes="accent" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" Command="{Binding CreateProjectCommand}" />
          </StackPanel>
        </Border>

        <Border Background="{StaticResource AppPanelBrush}" CornerRadius="10" Padding="16">
          <StackPanel Spacing="10">
            <TextBlock Text="OPEN EXISTING PROJECT" Classes="sectionTitle" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBox Grid.Column="0" Watermark="Project folder" Text="{Binding OpenExistingPath}" />
              <Button Grid.Column="1" Content="…" Classes="subtle" Margin="6,0,0,0" Click="OnBrowseOpenExisting" />
            </Grid>
            <Button Content="Add + Open" Classes="accent" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" Command="{Binding OpenExistingCommand}" />
          </StackPanel>
        </Border>

        <Border Background="{StaticResource AppPanelBrush}" CornerRadius="10" Padding="16">
          <StackPanel Spacing="4">
            <TextBlock Text="DEFAULT EDITOR" Classes="sectionTitle" />
            <TextBlock Text="{Binding DefaultVersionLabel}" Foreground="{StaticResource AppTextPrimaryBrush}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

      </StackPanel>
    </Grid>

    <!-- Status bar -->
    <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Foreground="{StaticResource AppTextSecondaryBrush}"
               Margin="4,16,0,0" FontSize="12" />

  </Grid>

</Window>
