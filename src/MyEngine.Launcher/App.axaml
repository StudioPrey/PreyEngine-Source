<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MyEngine.Launcher.App"
             RequestedThemeVariant="Dark">

  <Application.Resources>
    <ResourceDictionary>
      <SolidColorBrush x:Key="AppBackgroundBrush">#1B1D23</SolidColorBrush>
      <SolidColorBrush x:Key="AppPanelBrush">#22252C</SolidColorBrush>
      <SolidColorBrush x:Key="AppPanelAltBrush">#272A32</SolidColorBrush>
      <SolidColorBrush x:Key="AppBorderBrush">#33363F</SolidColorBrush>
      <SolidColorBrush x:Key="AppAccentBrush">#5B8DEF</SolidColorBrush>
      <SolidColorBrush x:Key="AppAccentHoverBrush">#6E9CF2</SolidColorBrush>
      <SolidColorBrush x:Key="AppTextPrimaryBrush">#EDEFF3</SolidColorBrush>
      <SolidColorBrush x:Key="AppTextSecondaryBrush">#9BA1AE</SolidColorBrush>
      <SolidColorBrush x:Key="AppWarningBrush">#E5A54B</SolidColorBrush>
      <SolidColorBrush x:Key="AppDangerBrush">#E0685E</SolidColorBrush>
    </ResourceDictionary>
  </Application.Resources>

  <!-- Style elements must live in Application.Styles, not inside a ResourceDictionary — a
       ResourceDictionary only accepts keyed resources (brushes, etc.), not Style objects. -->
  <Application.Styles>
    <FluentTheme />

    <Style Selector="Button.accent">
      <Setter Property="Background" Value="{StaticResource AppAccentBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="16,8" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>

    <Style Selector="Button.subtle">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource AppTextSecondaryBrush}" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>

    <Style Selector="TextBlock.sectionTitle">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource AppTextSecondaryBrush}" />
    </Style>

    <Style Selector="TextBox">
      <Setter Property="Background" Value="{StaticResource AppPanelAltBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10,7" />
    </Style>

    <Style Selector="ComboBox">
      <Setter Property="Background" Value="{StaticResource AppPanelAltBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
  </Application.Styles>

</Application>
