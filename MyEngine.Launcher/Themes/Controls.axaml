<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ============================ Typography ============================
       Foreground is set once on the windows (inherited), so these only change size / weight / tone. -->

  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="30" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="TextBlock.h3">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource PreyTextMuted}" />
  </Style>
  <Style Selector="TextBlock.body">
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="Foreground" Value="{DynamicResource PreyTextMuted}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource PreyTextMuted}" />
  </Style>
  <Style Selector="TextBlock.colhead">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource PreyTextFaint}" />
  </Style>
  <Style Selector="TextBlock.rowTitle">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.cell">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource PreyTextMuted}" />
  </Style>
  <Style Selector="TextBlock.warn">
    <Setter Property="Foreground" Value="{DynamicResource PreyWarn}" />
  </Style>
  <Style Selector="TextBlock.danger">
    <Setter Property="Foreground" Value="{DynamicResource PreyDanger}" />
  </Style>

  <!-- ============================== Icons ==============================
       Path.icon draws one of the 24x24 stroke geometries from Icons.axaml. Inside a Button the stroke
       follows the button's Foreground, so hover / active colours come for free. -->

  <Style Selector="Path.icon">
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="StrokeThickness" Value="1.7" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Stroke" Value="{DynamicResource PreyTextMuted}" />
  </Style>
  <Style Selector="Button Path.icon">
    <Setter Property="Stroke" Value="{Binding $parent[Button].Foreground}" />
  </Style>
  <Style Selector="Path.mark">
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Fill" Value="{DynamicResource PreyText}" />
  </Style>

  <!-- ============================= Surfaces ============================= -->

  <!-- a project row: no divider, a rounded highlight on hover -->
  <Style Selector="Border.row">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="0,10" />
    <Setter Property="Margin" Value="0,0,0,2" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.14" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.row:pointerover">
    <Setter Property="Background" Value="{DynamicResource PreyRaised}" />
  </Style>

  <!-- project monogram: a leaf-cornered tile, tinted when the project is pinned -->
  <Style Selector="Border.tile">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
    <Setter Property="CornerRadius" Value="13,3,13,3" />
    <Setter Property="Background" Value="{DynamicResource PreyRaised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PreyLine}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.tile.pinned">
    <Setter Property="Background" Value="{DynamicResource PreyAccentSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PreyAccent}" />
  </Style>

  <Style Selector="Border.chip">
    <Setter Property="Background" Value="{DynamicResource PreyRaised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PreyLine}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="9,4" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.chip.accent">
    <Setter Property="Background" Value="{DynamicResource PreyAccentSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PreyAccent}" />
  </Style>
  <Style Selector="Border.chip.problem">
    <Setter Property="Background" Value="{DynamicResource PreyDangerSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PreyDanger}" />
  </Style>

  <!-- the thin tapered mark beside the active sidebar button -->
  <Style Selector="Border.blade">
    <Setter Property="Width" Value="3" />
    <Setter Property="Height" Value="22" />
    <Setter Property="CornerRadius" Value="0,3,3,0" />
    <Setter Property="Background" Value="{DynamicResource PreyAccent}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- wizard step indicator -->
  <Style Selector="Border.stepbar">
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="3" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Background" Value="{DynamicResource PreyLineStrong}" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.25" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.stepbar.on">
    <Setter Property="Background" Value="{DynamicResource PreyAccent}" />
  </Style>

  <!-- dialog card: leaf corners, rises in when the "open" class is added -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource PreySurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PreyLineStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="30,6,30,6" />
    <Setter Property="Padding" Value="30" />
    <Setter Property="BoxShadow" Value="0 28 80 0 #66000000" />
    <Setter Property="Opacity" Value="0" />
    <Setter Property="RenderTransform" Value="translateY(18px)" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.26" Easing="CubicEaseOut" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.32" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.card.open">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="RenderTransform" Value="none" />
  </Style>

  <!-- the selectable project-type card in the wizard -->
  <Style Selector="Border.typecard">
    <Setter Property="Background" Value="{DynamicResource PreyAccentSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PreyAccent}" />
    <Setter Property="BorderThickness" Value="1.5" />
    <Setter Property="CornerRadius" Value="22,5,22,5" />
    <Setter Property="Padding" Value="20" />
  </Style>

  <!-- error panel inside the launch card -->
  <Style Selector="Border.errorbox">
    <Setter Property="Background" Value="{DynamicResource PreyDangerSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PreyDanger}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="14" />
  </Style>

  <!-- settings row -->
  <Style Selector="Border.setting">
    <Setter Property="BorderBrush" Value="{DynamicResource PreyLine}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="0,18" />
  </Style>

  <!-- panel on the Editor versions page -->
  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource PreyRaised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PreyLine}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="22,5,22,5" />
    <Setter Property="Padding" Value="22" />
  </Style>

  <!-- ============================== Pages ==============================
       All pages sit in one grid; the active one fades in when "shown" is added. -->
  <Style Selector="Panel.page">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.22" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Panel.page.shown">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <!-- ============================ Inputs, bars =========================== -->

  <Style Selector="TextBox">
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="MinHeight" Value="42" />
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="ProgressBar.thin">
    <Setter Property="MinHeight" Value="3" />
    <Setter Property="Height" Value="3" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Background" Value="{DynamicResource PreyLine}" />
    <Setter Property="Foreground" Value="{DynamicResource PreyAccent}" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Value" Duration="0:0:0.45" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>

  <!-- ===================== Launch steps (progress card) ===================== -->

  <Style Selector="TextBlock.step">
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="Foreground" Value="{DynamicResource PreyTextFaint}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.step.active">
    <Setter Property="Foreground" Value="{DynamicResource PreyText}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.step.done">
    <Setter Property="Foreground" Value="{DynamicResource PreyTextMuted}" />
  </Style>
  <Style Selector="TextBlock.step.failed">
    <Setter Property="Foreground" Value="{DynamicResource PreyDanger}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- the dot that breathes while a step is running -->
  <Style Selector="Border.pulse">
    <Style.Animations>
      <Animation Duration="0:0:0.9" IterationCount="INFINITE" PlaybackDirection="Alternate" Easing="SineEaseInOut">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0.3" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

</Styles>
