<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MyEngine.Launcher.App"
             RequestedThemeVariant="Dark">

  <!-- Palette (per theme variant), geometry/icons and button themes. Styles that use them are in Themes/Controls.axaml. -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/Themes/Colors.axaml" />
        <ResourceInclude Source="/Themes/Icons.axaml" />
        <ResourceInclude Source="/Themes/ButtonThemes.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="/Themes/Controls.axaml" />
  </Application.Styles>

</Application>
