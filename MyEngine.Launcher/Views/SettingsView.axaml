<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MyEngine.Launcher.Views.SettingsView">

  <!-- DataContext is the SettingsViewModel -->
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="36,32,36,28" MaxWidth="760" HorizontalAlignment="Left">

      <TextBlock Classes="h1" Text="Settings" />

      <!-- Appearance -->
      <TextBlock Classes="h3" Text="Appearance" Margin="0,30,0,2" />
      <Border Classes="setting">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="3" VerticalAlignment="Center">
            <TextBlock Text="Theme" FontWeight="SemiBold" />
            <TextBlock Classes="caption" Text="Dark is black with a touch of blue. Light is white with a touch of green." />
          </StackPanel>
          <Border Grid.Column="1" Padding="3" CornerRadius="12"
                  Background="{DynamicResource PreyRaised}"
                  BorderBrush="{DynamicResource PreyLine}" BorderThickness="1">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <Button Theme="{StaticResource SegmentButton}" Classes.active="{Binding IsDarkTheme}"
                      Command="{Binding SetDarkCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Path Classes="icon" Data="{StaticResource IconMoon}" Width="16" Height="16" />
                  <TextBlock Text="Dark" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Theme="{StaticResource SegmentButton}" Classes.active="{Binding IsLightTheme}"
                      Command="{Binding SetLightCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Path Classes="icon" Data="{StaticResource IconSun}" Width="16" Height="16" />
                  <TextBlock Text="Light" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <!-- Projects -->
      <TextBlock Classes="h3" Text="Projects" Margin="0,30,0,2" />
      <Border Classes="setting">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="3" VerticalAlignment="Center" Margin="0,0,24,0">
            <TextBlock Text="Default project location" FontWeight="SemiBold" />
            <TextBlock Classes="caption" Text="The New project wizard starts in this folder. Leave empty for Documents\MyEngine Projects." />
          </StackPanel>
          <Grid Grid.Column="1" ColumnDefinitions="300,Auto" VerticalAlignment="Center">
            <TextBox Text="{Binding DefaultProjectLocation}" Watermark="Documents\MyEngine Projects" />
            <Button Grid.Column="1" Theme="{StaticResource GhostButton}" Margin="8,0,0,0" Width="46" Height="42"
                    Padding="0" Click="OnBrowseLocationClick" ToolTip.Tip="Browse for a folder">
              <Path Classes="icon" Data="{StaticResource IconFolderOpen}" Width="18" Height="18" />
            </Button>
          </Grid>
        </Grid>
      </Border>

      <!-- Behavior -->
      <TextBlock Classes="h3" Text="Behavior" Margin="0,30,0,2" />
      <Border Classes="setting">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="3" VerticalAlignment="Center">
            <TextBlock Text="Minimize after opening a project" FontWeight="SemiBold" />
            <TextBlock Classes="caption" Text="Move the launcher out of the way once the editor window is up." />
          </StackPanel>
          <ToggleSwitch Grid.Column="1" IsChecked="{Binding MinimizeOnOpen}" OnContent="" OffContent=""
                        VerticalAlignment="Center" />
        </Grid>
      </Border>

      <!-- Data -->
      <TextBlock Classes="h3" Text="Data" Margin="0,30,0,2" />
      <Border Classes="setting">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="3" VerticalAlignment="Center" Margin="0,0,24,0">
            <TextBlock Text="Launcher data folder" FontWeight="SemiBold" />
            <TextBlock Classes="caption" Text="Your project list, editor versions and these settings are stored here." />
            <TextBlock Classes="caption warn" Text="{Binding StatusMessage}" TextWrapping="Wrap" />
          </StackPanel>
          <Button Grid.Column="1" Theme="{StaticResource GhostButton}" Command="{Binding OpenDataFolderCommand}"
                  VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Path Classes="icon" Data="{StaticResource IconFolderOpen}" Width="18" Height="18" />
              <TextBlock Text="Open folder" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </Grid>
      </Border>

      <!-- About + license -->
      <TextBlock Classes="h3" Text="About" Margin="0,30,0,14" />
      <Grid ColumnDefinitions="Auto,*">
        <Border Width="64" Height="64" CornerRadius="22,5,22,5" VerticalAlignment="Top"
                Background="{DynamicResource PreyRaised}"
                BorderBrush="{DynamicResource PreyLine}" BorderThickness="1">
          <Path Classes="mark" Data="{StaticResource PreyMark}" Width="30" Height="32"
                HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" Margin="18,0,0,0" Spacing="4" VerticalAlignment="Center">
          <TextBlock Text="PreyEngine" FontSize="18" FontWeight="Bold" />
          <TextBlock Classes="muted" Text="EasyPrey Studio's own 2D game engine." />
          <TextBlock Classes="muted" Text="Released under the MIT License. Copyright © 2026 EasyPrey Studio." />
        </StackPanel>
      </Grid>

    </StackPanel>
  </ScrollViewer>

</UserControl>
