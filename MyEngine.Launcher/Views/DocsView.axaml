<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MyEngine.Launcher.Views.DocsView">

  <Grid RowDefinitions="Auto,*" Margin="36,32,36,28">

    <TextBlock Classes="h1" Text="Documentation" />

    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
      <Border Width="68" Height="68" CornerRadius="24,5,24,5" HorizontalAlignment="Center"
              Background="{DynamicResource PreyAccentSoft}">
        <Path Classes="icon" Data="{StaticResource IconNewspaper}" Width="30" Height="30"
              Stroke="{DynamicResource PreyAccent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <TextBlock Classes="h2" Text="Coming soon" HorizontalAlignment="Center" />
    </StackPanel>

  </Grid>

</UserControl>
